# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# temp / debug files
tmp*
lint_log.txt
rotations.txt
verify_*
test-tz.mjs

# generated reports
generate_report.js
public/*.pptx
*.pptx

# claude code worktrees (실수로 gitlink 로 커밋되던 항목)
.claude/worktrees/

# python bytecode (보드 빌더가 _detail_ko 등을 import 할 때 생긴다)
__pycache__/
*.py[cod]
